# AgniSetu configuration. Copy this file to .env and fill in what you need.
# Every variable is optional; the defaults run the app locally.

# Free NASA FIRMS key, used only to backfill the current year.
# Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
AGNISETU_FIRMS_MAP_KEY=

# Shared secret that enables the ingestion controls on the Data tab.
# Leave empty to disable those routes entirely. Use a long random value.
AGNISETU_ADMIN_TOKEN=

# Comma separated FIRMS country names that form the analysis domain.
# Supported: India, Pakistan, Nepal, Bangladesh, Bhutan, Sri_Lanka, Argentina
AGNISETU_COUNTRIES=India,Pakistan,Argentina

# Network
AGNISETU_HOST=127.0.0.1
AGNISETU_PORT=8000
AGNISETU_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API from another site. Empty keeps the API same origin only.
AGNISETU_ALLOWED_ORIGINS=
# Set to true only behind a TLS terminating proxy.
AGNISETU_ENABLE_HSTS=false
# Set to true only if a trusted proxy overwrites X-Forwarded-For.
AGNISETU_TRUST_FORWARDED_FOR=false

# Limits
AGNISETU_RATE_LIMIT_PER_MINUTE=300
AGNISETU_HEAVY_RATE_LIMIT_PER_MINUTE=180
AGNISETU_MAX_CONCURRENT_HEAVY=3

# Minutes between automatic refreshes of the 7 day feeds. 0 disables the scheduler.
AGNISETU_NRT_REFRESH_MINUTES=180

AGNISETU_LOG_LEVEL=INFO
